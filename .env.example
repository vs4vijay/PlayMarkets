# ─────────────────────────────────────────────────────────────────────────────
# PlayMarkets — Environment variable reference
# Copy to .env.local and fill in your values.
#
# Supported CRICKET_PROVIDER values:
# Supported values: cricketdata | entitysport | sportmonks | freewebapi | cricbuzz | roanuz | mock
# Change CRICKET_PROVIDER to switch between data sources:
#   mock        — rich IPL 2026 demo data (no credentials needed)
#   cricketdata — api.cricapi.com           (free 100 req/day)
#   entitysport — restapi.entitysport.com   (free dev token included)
#   sportmonks  — cricket.sportmonks.com    (free trial)
#   freewebapi  — unofficial-cricbuzz RapidAPI
#   cricbuzz    — cricbuzz-cricket RapidAPI
#   roanuz      — api.sports.roanuz.com     (free dev key included)
# ─────────────────────────────────────────────────────────────────────────────

# Active provider (default: mock — safe fallback with rich IPL demo data)
CRICKET_PROVIDER=mock

# ─── Provider 1: CricketData (api.cricapi.com) ───────────────────────────────
# Free tier: 100 requests/day
# Sign up & get your key at: https://cricketdata.org/
# To activate: set CRICKET_PROVIDER=cricketdata
CRICKETDATA_API_KEY=your_cricketdata_api_key_here

# ─── Provider 2: EntitySport (restapi.entitysport.com) ───────────────────────
# Free development token gives access to sample/historical data.
# For production (live IPL data), get a token at: https://entitysport.com/
# Dev token (sample data): ec471071441bb2ac538a0ff901abd249
# To activate: set CRICKET_PROVIDER=entitysport
ENTITYSPORT_TOKEN=ec471071441bb2ac538a0ff901abd249

# ─── Provider 3: Sportmonks (cricket.sportmonks.com) ─────────────────────────
# Free trial available. Sign up at: https://sportmonks.com/cricket
# To activate: set CRICKET_PROVIDER=sportmonks
SPORTMONKS_API_TOKEN=your_sportmonks_token_here

# ─── Provider 4: FreeWebAPI / Unofficial Cricbuzz (unofficial-cricbuzz.p.rapidapi.com) ──
# Free tier via RapidAPI. Subscribe at: https://rapidapi.com/
# API: "Unofficial Cricbuzz" — same RAPIDAPI_KEY is shared with cricbuzz provider
# To activate: set CRICKET_PROVIDER=freewebapi
RAPIDAPI_KEY=your_rapidapi_key_here

# ─── Provider 5: Cricbuzz Unofficial (cricbuzz-cricket.p.rapidapi.com) ───────
# Free tier via RapidAPI. Subscribe at: https://rapidapi.com/
# API: "cricbuzz-cricket" — uses the same RAPIDAPI_KEY as freewebapi
# To activate: set CRICKET_PROVIDER=cricbuzz

# (uses RAPIDAPI_KEY above)

# ─── Provider 6: Roanuz (api.sports.roanuz.com) ──────────────────────────────
# Sign up at: https://developer.roanuz.com/
# Dev project key "dev_season_2014" returns 2013/2014 season sample data.
# For live data, get a production project key.
# To activate: set CRICKET_PROVIDER=roanuz
ROANUZ_API_KEY=your_roanuz_api_key_here
ROANUZ_PROJECT_KEY=dev_season_2014
